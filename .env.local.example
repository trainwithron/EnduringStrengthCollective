NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Powers the AI workout-photo importer and the AI meal-plan assist button.
# Get a key at https://console.anthropic.com/settings/keys — both features
# degrade to a clear "not configured" message when this is unset, so the
# app runs fine without it.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-only, bypasses Row Level Security — never expose this to the
# client. Only the Stripe checkout/webhook routes use it (they have no
# user session to check RLS against). Find it in Supabase: Project
# Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Powers Stripe Checkout (session-credit packs + recurring monthly
# membership) and the "Manage billing" portal link. Get test-mode keys at
# https://dashboard.stripe.com/test/apikeys. Create one Price for each
# product in the Stripe Dashboard and paste its ID below. All billing
# buttons degrade to a clear "not configured" message when these are
# unset, so the app runs fine without them.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# From the Stripe CLI (`stripe listen`) locally, or the webhook's signing
# secret in the Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_SESSION_CREDIT_PACK=price_your-credit-pack-price-id
STRIPE_PRICE_MEMBERSHIP_MONTHLY=price_your-membership-price-id

# Powers video calling on 1-on-1 bookings marked "video" (Daily.co
# Prebuilt embed). Get a key at https://dashboard.daily.co/developers —
# the free tier covers a realistic pilot's usage. The "Join call"
# control degrades to a clear "not configured" message when this is
# unset, so the app runs fine without it.
DAILY_API_KEY=your-daily-api-key

# Powers the "Connect Oura" flow on the athlete settings page and the
# daily sync job. Register a self-serve OAuth2 app at
# https://cloud.ouraring.com/oauth/applications — set the redirect URI
# there to match OURA_REDIRECT_URI below exactly (e.g.
# https://yourapp.com/api/oura/callback, or http://localhost:3000/api/oura/callback
# locally). The connect button degrades to a clear "not configured"
# message when these are unset, so the app runs fine without them.
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret
OURA_REDIRECT_URI=http://localhost:3000/api/oura/callback

# Powers the "Connect Withings" flow on the athlete settings page and its
# own daily sync job (weight only). Register a self-serve OAuth2 app at
# https://developer.withings.com/dashboard/ — set the redirect URI there
# to match WITHINGS_REDIRECT_URI below exactly. Same graceful-degrade
# behavior as Oura when unset.
WITHINGS_CLIENT_ID=your-withings-client-id
WITHINGS_CLIENT_SECRET=your-withings-client-secret
WITHINGS_REDIRECT_URI=http://localhost:3000/api/withings/callback

# Powers the "Connect Garmin" flow on the athlete settings page. Real
# blocker, not a config oversight: Garmin's Health API requires a real
# partner-program business application (~2 business days) before these
# credentials exist at all — apply at https://developer.garmin.com/gc-developer-program/.
# Garmin's own OAuth2 flow is push-based, not polled (see lib/garmin.ts) —
# GARMIN_WEBHOOK_SECRET is this app's own shared-secret value, given to
# Garmin at partner-registration time as this app's webhook callback
# auth (Garmin's real webhook-signing mechanism isn't publicly
# documented; re-verify once partner access exists). Degrades gracefully
# to "not configured" when unset, same as every other provider here.
GARMIN_CLIENT_ID=your-garmin-client-id
GARMIN_CLIENT_SECRET=your-garmin-client-secret
GARMIN_REDIRECT_URI=http://localhost:3000/api/garmin/callback
GARMIN_WEBHOOK_SECRET=your-garmin-webhook-shared-secret

# Powers the "Connect Google Health" flow on the athlete settings page
# and its own daily sync job. Register an OAuth2 client in a real Google
# Cloud project at https://console.cloud.google.com/ and request access
# to the Google Health API (developers.google.com/health) — restricted
# scopes need a real Google app-verification review before production,
# with real lead time (see wearables_integration.md). Same graceful-
# degrade behavior as every other provider here when unset.
GOOGLE_HEALTH_CLIENT_ID=your-google-health-client-id
GOOGLE_HEALTH_CLIENT_SECRET=your-google-health-client-secret
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/google-health/callback

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# it calls /api/oura/sync on schedule (see vercel.json) — set the same
# value here and as a Vercel project env var. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-random-cron-secret

# Powers real outbound SMS (session reminders, booking confirmations,
# attendance nudges, low-credit alerts — see lib/sms-dispatch.ts). Fully
# self-serve at https://www.twilio.com — no OAuth/partner-approval gate,
# but real production sending at US A2P volume requires Twilio's own
# 10DLC business/campaign registration first (a separate step with its
# own ~1-2 business day lead time, not something these three vars alone
# unlock). Every SMS also stays gated behind each coach's own opt-in +
# quiet-hours config (coach_sms_config) regardless of these being set.
# Degrades to a silent no-op when unset, same as every other provider.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15555550100

# Powers real outbound transactional email (lib/sendgrid.ts) — shared
# plumbing, not yet wired to a specific feature (password reset,
# receipts, etc. are real future callers). Self-serve at
# https://sendgrid.com, free tier covers 100 emails/day indefinitely —
# no app-review gate, the lowest-friction provider in this app.
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
